# Copy to .env and replace the placeholders. Every variable is required.
# Only virtual-money settings belong here: no provider, broker or live keys.

# HTTP server. 0.0.0.0 is for inside the api container, which Compose
# publishes on 127.0.0.1 only; when running on the host, use 127.0.0.1.
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL, shared by the postgres image and the api.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mizar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mizar

# Upper bound in seconds for one database health check.
HEALTH_TIMEOUT_SECONDS=2

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
